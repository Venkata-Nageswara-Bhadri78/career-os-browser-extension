# API the service worker calls (job-extraction only)
WXT_API_BASE_URL=http://localhost:8080

# Primary website origin (Connect button + default externally_connectable)
WXT_WEBSITE_ORIGIN=http://localhost:5173

# Extra website origins, comma-separated, no trailing slashes
WXT_WEBSITE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Production website origin when known (included in externally_connectable). Leave empty in local .env
WXT_WEBSITE_ORIGIN_PROD=

WXT_WEBSITE_LOGIN_PATH=/login
WXT_WEBSITE_AFTER_EXTRACT_PATH=/
