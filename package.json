{
  "name": "copilot-job-capture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome MV3 extension that captures job postings for Copilot extraction.",
  "scripts": {
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "zip": "wxt zip --browser chrome",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  }
}
